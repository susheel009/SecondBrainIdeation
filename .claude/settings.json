{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",

      "Bash(ls:*)",
      "Bash(cat:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git stash pop:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",

      "Bash(git push origin develop:*)",
      "Bash(git push -u origin develop:*)"
    ],
    "deny": [
      "Bash(git push * main*)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git commit --amend*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",

      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(rmdir *)",

      "Bash(npm install*)",
      "Bash(npm uninstall*)",
      "Bash(yarn add*)",
      "Bash(pip install*)",
      "Bash(pip uninstall*)",

      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /c/Project/claude/SecondBrainIdeation && git status --porcelain | grep -q . && git add -A && git commit -m \"auto-save: $(date '+%Y-%m-%d %H:%M')\" && git push origin develop || true",
            "statusMessage": "Auto-saving changes to develop..."
          }
        ]
      }
    ]
  }
}
